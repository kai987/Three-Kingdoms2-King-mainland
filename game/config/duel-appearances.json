  "sources": {
    "novel-001": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 1,
      "url": "https://zh.wikisource.org/wiki/三國演義/第001回",
      "summary": "桃園結義後分別製作劉備雙股劍、關羽青龍偃月刀及張飛丈八點鋼矛。"
    },
    "novel-003": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 3,
      "url": "https://zh.wikisource.org/wiki/三國演義/第003回",
      "summary": "呂布持方天畫戟；李肅送赤兔，正文形容其全身赤色。"
    },
    "novel-005": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 5,
      "url": "https://zh.wikisource.org/wiki/三國演義/第005回",
      "summary": "孫堅持古錠刀、騎花鬃馬；程普使用鐵脊蛇矛，韓當使用大刀，潘鳳手提大斧。"
    },
    "novel-007": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 7,
      "url": "https://zh.wikisource.org/wiki/三國演義/第007回",
      "summary": "趙雲救公孫瓚時以槍與文醜交戰；文醜同樣使用槍。"
    },
    "novel-014": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 14,
      "url": "https://zh.wikisource.org/wiki/三國演義/第014回",
      "summary": "許褚與徐晃交鋒使用刀、斧；曹操曾持寶劍督戰。"
    },
    "novel-015": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 15,
      "url": "https://zh.wikisource.org/wiki/三國演義/第015回",
      "summary": "神亭之戰，孫策與太史慈均持槍交鋒。"
    },
    "novel-016": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 16,
      "url": "https://zh.wikisource.org/wiki/三國演義/第016回",
      "summary": "胡車兒設法偷走典韋雙鐵戟，這是其代表兵器。"
    },
    "novel-025": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 25,
      "url": "https://zh.wikisource.org/wiki/三國演義/第025回",
      "summary": "曹操把呂布舊騎赤兔交給關羽；顏良在陣前持刀。"
    },
    "novel-034": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 34,
      "url": "https://zh.wikisource.org/wiki/三國演義/第034回",
      "summary": "劉備騎的盧赴襄陽宴會，遇害逃出並躍過檀溪。"
    },
    "novel-042": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 42,
      "url": "https://zh.wikisource.org/wiki/三國演義/第042回",
      "summary": "長坂橋的張飛持蛇矛，與第一回丈八點鋼矛合用為其代表兵器。"
    },
    "novel-053": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 53,
      "url": "https://zh.wikisource.org/wiki/三國演義/第053回",
      "summary": "黃忠能開二石力之弓，交鋒用刀；該章未稱其弓為鐵胎，換乘的是韓玄青馬。張遼持刀迎戰太史慈，孫權亦曾準備持槍。"
    },
    "novel-059": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 59,
      "url": "https://zh.wikisource.org/wiki/三國演義/第059回",
      "summary": "馬超持槍與許褚交戰，許褚使用鋼刀。"
    },
    "novel-063": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 63,
      "url": "https://zh.wikisource.org/wiki/三國演義/第063回",
      "summary": "劉備入蜀時將自己的馴熟白馬換給龐統，後者在落鳳坡遇伏。與第三十四回合讀，以白色的盧作劉備代表視覺。"
    },
    "novel-067": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 67,
      "url": "https://zh.wikisource.org/wiki/三國演義/第067回",
      "summary": "夏侯淵迎戰昌奇、楊任，以刀作戰。"
    },
    "novel-070": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 70,
      "url": "https://zh.wikisource.org/wiki/三國演義/第070回",
      "summary": "張郃持槍迎戰張飛，夜襲時刺中草人；黃忠持大刀。"
    },
    "novel-074": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 74,
      "url": "https://zh.wikisource.org/wiki/三國演義/第074回",
      "summary": "龐德在關平、關羽面前以鋼刀、白馬出陣。"
    },
    "novel-093": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 93,
      "url": "https://zh.wikisource.org/wiki/三國演義/第093回",
      "summary": "姜維以槍迎戰趙雲，正文特別描寫其槍法。"
    },
    "novel-094": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 94,
      "url": "https://zh.wikisource.org/wiki/三國演義/第094回",
      "summary": "魏延截擊曹遵，以刀斬將。"
    },
    "novel-020": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 20,
      "url": "https://zh.wikisource.org/wiki/三國演義/第020回",
      "summary": "曹操在許田圍獵時乘爪黃飛電；該段未指定完整毛色。"
    },
    "novel-097": {
      "work": "三國演義",
      "edition": "一百二十回本（維基文庫轉錄）",
      "chapter": 97,
      "url": "https://zh.wikisource.org/wiki/三國演義/第097回",
      "summary": "曹真推薦的王雙使用兩石鐵胎弓；此段不是黃忠使用鐵胎弓的證據。"
    },
    "sanguozhi-001": {
      "work": "三國志",
      "edition": "陳壽撰、裴松之注（維基文庫轉錄）",
      "chapter": 1,
      "url": "https://zh.wikisource.org/wiki/三國志/卷01",
      "summary": "武帝紀建安二年宛城段注引魏書，明記曹操所乘馬名絕影；沒有指定毛色。"
    },
    "sanguozhi-047": {
      "work": "三國志",
      "edition": "陳壽撰、裴松之注（維基文庫轉錄）",
      "chapter": 47,
      "url": "https://zh.wikisource.org/wiki/三國志/卷47",
      "summary": "吳主傳記孫權乘駿馬越津橋，江表傳注記谷利助鞭；該段未命名快航。"
    },
    "taiping-yulan-0897": {
      "work": "太平御覽",
      "edition": "卷897引崔豹古今注（維基文庫轉錄）",
      "chapter": 897,
      "url": "https://zh.wikisource.org/wiki/太平御覽/0897",
      "summary": "古今注引文將驚帆記為曹真的駃馬，非孫權之馬；形容其疾馳如烈風舉帆。"
    }
  },
