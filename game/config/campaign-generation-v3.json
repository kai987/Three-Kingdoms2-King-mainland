      ],
      "faction": "yellow_turban",
      "reason": "黄巾起兵章节，源快照为1月，战役改在3月；不把教团当作既成行政国家。",
      "sources": [
        {
          "url": "https://zh.wikisource.org/wiki/後漢書/卷71",
          "section": "皇甫嵩",
          "note": "中平元年黄巾起事。",
          "scope": "historical_revision_with_explicit_board_proxy"
        }
      ]
    },
    {
      "year": 190,
