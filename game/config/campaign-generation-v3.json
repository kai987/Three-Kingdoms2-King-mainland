      "year": 184,
      "source_rulers": [
        "何進",
        "董卓",
        "孫堅",
        "公孫瓚",
        "劉焉",
        "丁原",
        "士燮",
        "馬騰"
      ],
      "faction": "han",
      "reason": "184年这些来源集团按汉廷官军合并，保留各人来源君主，不提前建立后来的割据国家。",
      "sources": [
        {
          "url": "https://zh.wikisource.org/wiki/三國志/卷01",
          "section": "武帝纪与诸传",
          "note": "何进、董卓、孙坚等此时均为汉臣军官；宏观军团合并为玩法安排。",
          "scope": "historical_revision_with_explicit_board_proxy"
        },
        {
          "url": "https://zh.wikisource.org/wiki/後漢書/卷75",
          "section": "刘焉",
          "note": "刘焉入蜀在188年，不能按184年来源预置为独立益州政权。",
          "scope": "historical_revision_with_explicit_board_proxy"
        }
      ]
    },
    {
      "year": 184,
      "source_rulers": [
